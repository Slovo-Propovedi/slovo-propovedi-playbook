#jinja2: lstrip_blocks: True
[Unit]
Description=slovo-swagger
{% for service in slovo_swagger_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} slovo-swagger 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm slovo-swagger 2>/dev/null || true'
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
    --rm \
    --name=slovo-swagger \
    --log-driver=none \
    --user={{ slovo_user_uid }}:{{ slovo_user_gid }} \
    --cap-drop=ALL \
    --read-only \
    --tmpfs /tmp \
    --tmpfs /var/cache/nginx \
    --network={{ slovo_swagger_container_network }} \
    --label-file={{ slovo_swagger_base_path }}/labels \
    {% for arg in slovo_swagger_container_extra_arguments %}
    {{ arg }} \
    {% endfor %}
    {{ slovo_swagger_container_image }}
{% for network in slovo_swagger_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} slovo-swagger
{% endfor %}
ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach slovo-swagger
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} slovo-swagger 2>/dev/null || true'
Restart=always
RestartSec=30
SyslogIdentifier=slovo-swagger

[Install]
WantedBy=multi-user.target
