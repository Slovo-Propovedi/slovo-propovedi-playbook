#jinja2: lstrip_blocks: True
[Unit]
Description=slovo-minio
{% for service in slovo_minio_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} slovo-minio 2>/dev/null || true'
ExecStartPre=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm slovo-minio 2>/dev/null || true'
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
    --rm \
    --name=slovo-minio \
    --log-driver=none \
    --user={{ slovo_user_uid }}:{{ slovo_user_gid }} \
    --cap-drop=ALL \
    --network={{ slovo_minio_container_network }} \
    --mount type=bind,src={{ slovo_minio_data_path }},dst=/data \
    --env-file={{ slovo_minio_base_path }}/env \
    --label-file={{ slovo_minio_base_path }}/labels \
    {% for arg in slovo_minio_container_extra_arguments %}
    {{ arg }} \
    {% endfor %}
    {{ slovo_minio_container_image }} server /data --address ":9000" --console-address ":9001"
{% for network in slovo_minio_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} slovo-minio
{% endfor %}
ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach slovo-minio
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ devture_systemd_docker_base_container_stop_grace_time_seconds }} slovo-minio 2>/dev/null || true'
Restart=always
RestartSec=30
SyslogIdentifier=slovo-minio

[Install]
WantedBy=multi-user.target
