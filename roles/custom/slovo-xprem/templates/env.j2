{#- Environment variable names follow the xprem docs (Quickstart / Database
    configuration / Local storage pages): DB_URL is what switches the server
    into control-plane mode, STORAGE_MODE=local with LOCAL_BUCKET_BASE_PATH
    points storage at the bind-mounted /data, and CACHE_MODE=local keeps the
    cache in-process (no Redis). If the first real apply logs "unknown
    environment variable" warnings, cross-check this list against the container
    docs for the pinned version and adjust. -#}
BASE_URL=https://{{ slovo_xprem_hostname }}
{# sslmode=disable is explicit: the stack's postgres serves no TLS, and relying on
   pgx's `prefer` default turns a misconfiguration into an SSL-negotiation session. #}
DB_URL=postgres://{{ slovo_xprem_postgres_user }}:{{ secret_slovo_xprem_postgres_password }}@slovo-postgres:5432/{{ slovo_xprem_postgres_db }}?sslmode=disable
DB_KEYS_MASTER_KEY_B64={{ secret_slovo_xprem_db_keys_master_key }}
JWT_SECRET={{ secret_slovo_xprem_jwt_secret }}
STORAGE_MODE=local
LOCAL_BUCKET_BASE_PATH=/data
CACHE_MODE=local
USE_DASHBOARD=true
ADMIN_EMAIL={{ slovo_xprem_admin_email }}
ADMIN_PASSWORD={{ secret_slovo_xprem_admin_password }}
