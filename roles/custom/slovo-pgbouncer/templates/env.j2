# PgBouncer connects to the postgres server over the Docker network.
# The edoburu/pgbouncer image entrypoint renders these into pgbouncer.ini
# and userlist.txt at container startup.
#
# LISTEN_PORT is 5432 (NOT 6432): the backend source hardcodes
# POSTGRES_PORT=5432 (see docs/deploying-backend.md), so the pooler must
# listen on 5432 for the backend to reach it.
DB_HOST={{ slovo_pgbouncer_postgres_host }}
DB_PORT={{ slovo_pgbouncer_postgres_port }}
DB_USER={{ slovo_pgbouncer_postgres_username }}
DB_PASSWORD={{ slovo_pgbouncer_postgres_password }}
DB_NAME={{ slovo_pgbouncer_postgres_dbname }}
LISTEN_PORT={{ slovo_pgbouncer_container_port }}
POOL_MODE={{ slovo_pgbouncer_pool_mode }}
DEFAULT_POOL_SIZE={{ slovo_pgbouncer_default_pool_size }}
MAX_CLIENT_CONN={{ slovo_pgbouncer_max_client_conn }}
MAX_DB_CONNECTIONS={{ slovo_pgbouncer_max_db_connections }}
