---
exclude_paths:
  # Vendored Galaxy roles (see requirements.yml) — not ours to fix.
  - roles/galaxy/
  - .ansible/

skip_list:
  # setup.yml deliberately imports roles by explicit `galaxy/...` and
  # `custom/...` path (see the comment above the roles: list there) so both
  # namespaces can live side by side under roles/ without name collisions.
  - role-name[path]
  # slovo-swap/slovo-buildx shell commands are already guarded by `when:`
  # conditions for idempotency; adding changed_when/pipefail correctly needs
  # a real look at each task's semantics, not a mechanical fix. Left as
  # follow-up cleanup rather than blocking CI.
  - no-changed-when
  - risky-shell-pipe
